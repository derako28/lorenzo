{
  "enableAllProjectMcpServers": true,
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Edit(drafts/**)",
      "Edit(analytics/**)",
      "Edit(competitors/**)",
      "Edit(edits.md)",
      "Edit(experiments.md)",
      "Edit(playbook.md)",
      "WebSearch",
      "WebFetch",
      "mcp__twitter-factory",
      "mcp__twitter-factory__list_workspaces",
      "mcp__twitter-factory__search_posts",
      "mcp__twitter-factory__rising_posts",
      "mcp__twitter-factory__pushed_topics",
      "mcp__twitter-factory__get_post",
      "mcp__twitter-factory__similar_posts",
      "mcp__twitter-factory__list_signals",
      "mcp__twitter-factory__list_videos",
      "mcp__twitter-factory__get_video",
      "mcp__twitter-factory__what_works",
      "mcp__twitter-factory__posting_times",
      "mcp__twitter-factory__own_stats",
      "mcp__twitter-factory__own_posts",
      "mcp__twitter-factory__own_published",
      "mcp__twitter-factory__latest_report",
      "Bash(node scripts/now.mjs:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git switch:*)",
      "Bash(git checkout:*)",
      "Bash(git branch:*)",
      "Bash(git remote:*)",
      "Bash(git push -u origin coach/:*)",
      "Bash(gh pr create:*)"
    ],
    "ask": [
      "mcp__twitter-factory__record_profile_analytics",
      "mcp__twitter-factory__record_post_metrics",
      "Edit(brief.md)"
    ],
    "deny": [
      "Read(../x-markelling/**)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(git reset --hard:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh repo delete:*)"
    ]
  }
}
